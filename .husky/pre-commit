set -e

echo "🔍 Running pre-commit checks..."

# Auto-fix linting and formatting issues
echo "📝 Fixing linting and formatting issues..."
pnpm check:fix

# Stage any files that were auto-fixed
echo "📦 Staging auto-fixed files..."
git add -u

# Run type checking (this will fail if there are type errors)
echo "🔎 Running type checks..."
pnpm type-check

# Run all tests (this will fail if any test fails)
echo "🧪 Running tests..."
pnpm test

echo "✅ Pre-commit checks passed!"
