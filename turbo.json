{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^prepare:dev"],
      "cache": false,
      "persistent": true
    },
    "prepare:dev": {
      "dependsOn": ["^prepare:dev"],
      "cache": false
    },
    "build:types": {
      "dependsOn": ["^build:types"],
      "outputs": ["dist/**/*.d.ts"]
    },
    "bench": {
      "dependsOn": ["^prepare:bench"],
      "cache": false
    },
    "prepare:bench": {
      "dependsOn": ["^prepare:bench"],
      "cache": false
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "type-check": {
      "dependsOn": ["^type-check"],
      "outputs": []
    },
    "check": {
      "dependsOn": ["^check"],
      "outputs": []
    },
    "test:watch": {
      "cache": false,
      "persistent": true,
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "^test"],
      "cache": false
    },
    "clean:full": {
      "dependsOn": ["^clean:full"],
      "cache": false
    },
    "clean": {
      "dependsOn": ["^clean"],
      "cache": false
    }
  }
}
