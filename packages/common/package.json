{
  "name": "@mandelbrot/common",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./worker-protocol": {
      "development": "./src/worker_protocol.ts",
      "types": "./dist/worker_protocol.d.ts",
      "import": "./dist/worker_protocol.js",
      "default": "./dist/worker_protocol.js"
    },
    "./utils": {
      "development": "./src/utils/index.ts",
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test:watch": "vitest --watch",
    "type-check": "tsc --noEmit",
    "lint": "biome lint .",
    "check": "biome check .",
    "test": "vitest run",
    "test:ui": "vitest --ui"
  },
  "devDependencies": {
    "@vitest/ui": "^4.0.15",
    "typescript": "~5.9.3",
    "vitest": "^4.0.15"
  }
}
