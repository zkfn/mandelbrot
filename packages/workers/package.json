{
  "name": "@mandelbrot/workers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./*": {
      "types": "./dist/workers/*.d.ts",
      "import": "./dist/workers/*.js",
      "default": "./dist/workers/*.js"
    }
  },
  "scripts": {
    "lint": "biome lint .",
    "check": "biome check .",
    "type-check": "tsc -b --noEmit",
    "build:vite": "tsx build-workers.ts",
    "build:types": "tsc -b --emitDeclarationOnly",
    "build": "pnpm build:vite && pnpm build:types",
    "prepare:dev": "pnpm build",
    "prepare:bench": "pnpm build",
    "clean": "rimraf dist/",
    "clean:full": "rimraf dist/ node_modules/ .turbo/ *.tsbuildinfo"
  },
  "dependencies": {
    "@mandelbrot/common": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "tsx": "^4.21.0"
  }
}
