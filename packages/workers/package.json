{
  "name": "@mandelbrot/workers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./*": {
      "types": "./dist/workers/*.d.ts",
      "import": "./dist/workers/*.js",
      "default": "./dist/workers/*.js"
    }
  },
  "scripts": {
    "build:vite": "tsc && tsx build-workers.ts",
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "lint": "biome lint .",
    "check": "biome check ."
  },
  "dependencies": {
    "@mandelbrot/common": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "tsx": "^4.21.0",
    "vite": "^7.2.4"
  }
}
